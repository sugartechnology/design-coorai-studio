# Server-only CRM API base URL. Include the /api prefix.
CRM_API_URL=http://localhost:9495/api

# Fixed tenant used by the first i-render deployment (branding / fallback).
CRM_COMPANY_SLUG=istikbal

# HMAC secret for HttpOnly portal session cookie (min 16 chars).
PORTAL_SESSION_SECRET=change-me-portal-session-secret

# CRM web origin for offer share/edit links (no trailing slash).
NEXT_PUBLIC_CRM_WEB_ORIGIN=http://localhost:3001
