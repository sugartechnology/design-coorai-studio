# Server-only CRM API base URL. Include the /api prefix.
CRM_API_URL=http://localhost:9495/api

# Tagservice planner API (same as Room Designer SUGARTECH_API_URL + /planner).
PLANNER_API_URL=http://localhost:8080/api/planner

# Optional: force a template id (istikbal | bellona), ignoring Host.
BRAND_OVERRIDE=bellona

# Fallback tenant slug when a host does not match a template. Host templates
# supply companySlug for unauthenticated CRM calls.
CRM_COMPANY_SLUG=istikbal

# HMAC secret for HttpOnly portal session cookie (min 16 chars).
PORTAL_SESSION_SECRET=change-me-portal-session-secret

# CRM web origin for offer share/edit links (no trailing slash).
# Also passed as Docker build-arg (NEXT_PUBLIC_* is baked at build time).
NEXT_PUBLIC_CRM_WEB_ORIGIN=http://localhost:3001

# --- Docker / compose (optional) ---
# WEB_PORT=3000
# WEB_CONTAINER_NAME=design_coorai_studio
# From inside Docker, host CRM often needs:
# CRM_API_URL=http://host.docker.internal:9495/api
